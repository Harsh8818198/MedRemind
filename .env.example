# MedRemind Configuration

# Groq or Gemini API Configuration
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (e.g., gemma-4-31b-it, gemma2-9b-it, llama-3.3-70b-versatile)
MODEL_NAME=gemma-4-31b-it

# Interaction Mode: 'text' or 'voice' (default: text)
# In text mode, prompts are typed into the console. In voice mode, pyttsx3/SpeechRecognition are used.
VOICE_MODE=text

# Default Patient Settings
PATIENT_NAME=Grandpa

# Scheduler configurations
# Retry interval in minutes for NO_RESPONSE status (default: 5)
RETRY_INTERVAL_MINUTES=5
